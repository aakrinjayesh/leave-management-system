generator client {
    provider = "prisma-client-js"
}

datasource db {
    provider = "postgresql"
    url      = env("DATABASE_URL")
}

enum UserType {
    EMPLOYEE
    MANAGER
    ADMIN
}

enum UserStatus {
    PENDING
    ACTIVE
    INACTIVE
    REJECTED
}

enum OTPPurpose {
    REGISTER
    LOGIN
    FORGOT_PASSWORD
}

enum LeaveStatus {
    PENDING
    APPROVED
    REJECTED
    CANCELLED
}

enum ProjectAssignmentStatus {
    ASSIGNED
    NOT_ASSIGNED
}

enum SubmissionFrequency {
    WEEKLY
    MONTHLY
}

enum DayOfWeek {
    MONDAY
    TUESDAY
    WEDNESDAY
    THURSDAY
    FRIDAY
    SATURDAY
    SUNDAY
}

enum WeekNumber {
    ALL
    FIRST
    SECOND
    THIRD
    FOURTH
    FIFTH
}

enum Gender {
    MALE
    FEMALE
    OTHER
}

enum MaritalStatus {
    SINGLE
    MARRIED
    OTHER
}

enum TaxRegime {
    OLD
    NEW
}

enum ResidentialStatus {
    RESIDENT
    NON_RESIDENT
    RESIDENT_NOT_ORDINARILY_RESIDENT
}

enum IncomeTaxComputationMode {
    PROJECTED
    FINAL
}

enum ResignationStatus {
    PENDING
    ACCEPTED
    REJECTED
    WITHDRAWN
}

model User {
    id           Int     @id @default(autoincrement())
    employeeCode String? @unique

    firstName String
    lastName  String

    email    String  @unique
    password String?

    phone       String?
    joiningDate DateTime?
    birthDate   DateTime?
    gender      Gender?

    // The highest completed-years count this employee has already been shown
    // an anniversary celebration for - lets it fire again at each new
    // anniversary (1, then 2, then 3...) without repeating within the same year.
    lastAnniversaryCelebratedYears Int?

    // Tracks the year the birthday email was last sent, so the daily job
    // never double-sends if it happens to run more than once on the same day.
    lastBirthdayEmailYear Int?

    // The year the birthday dashboard celebration overlay was last shown, so
    // it fires once per birthday instead of on every dashboard visit that day.
    lastBirthdayCelebratedYear Int?

    // HR/payroll fields - admin can always edit; employee can self-edit
    // everything here except pfNumber and salaryCtc, up to statutoryInfoEditCount
    // / bankInfoEditCount times each (see the counters below).
    pan               String?
    panHolderName     String?
    uan               String?
    aadharNumber      String?
    aadharHolderName  String?
    bankAccountNumber String?
    bankName          String?
    ifscCode          String?
    pfNumber          String?
    salaryCtc         Float?

    // Personal details - admin can always edit; employee can self-edit these
    // up to personalInfoEditCount times (see below).
    fatherName        String?
    fatherMotherPhone String?
    spouseName        String?
    maritalStatus     MaritalStatus?
    nationality       String?
    qualification     String?

    // How many times this employee has used their own self-service edit form
    // for each profile section - each capped at 3 in the controller; once used
    // up, only admin can change that section's fields. Admin edits never
    // touch these counters and are never limited.
    personalInfoEditCount  Int @default(0)
    statutoryInfoEditCount Int @default(0)
    bankInfoEditCount      Int @default(0)

    // Employment details shown on payslips.
    designation String?
    location    String?
    taxRegime   TaxRegime?

    // Extra identity fields only needed for the annual Income Tax Computation
    // Statement - admin-managed only, same as the other HR/payroll fields.
    residentialAddress String?
    wardNo             String?
    micrCode           String?
    residentialStatus  ResidentialStatus?

    // Uploaded document filenames (stored on disk, same pattern as leave
    // attachments) - admin-only to upload, view, and download.
    panDocumentUrl    String?
    aadharDocumentUrl String?
    bankDocumentUrl   String?
    photoUrl          String?
    documentUrl       String?

    userType UserType
    status   UserStatus @default(ACTIVE)

    // Latest exit date, shown on the Accounts table - cleared on reactivate.
    // Full history of every exit/rehire cycle lives in ExitRecord below.
    exitDate DateTime?

    managerId Int?

    isPasswordSet Boolean @default(false)

    isRegistrationAllowed Boolean @default(true)

    manager   User?  @relation("ManagerEmployees", fields: [managerId], references: [id])
    employees User[] @relation("ManagerEmployees")

    projectMemberships ProjectMembership[]

    createdAt           DateTime       @default(now())
    updatedAt           DateTime       @updatedAt
    otps                OTP[]
    refreshTokens       RefreshToken[]
    leaveBalances       LeaveBalance[]
    leaveRequests       LeaveRequest[] @relation("EmployeeLeaveRequests")
    routedLeaveRequests LeaveRequest[] @relation("RoutedLeaveRequests")
    approvedLeaves      LeaveRequest[] @relation("ManagerApprovedLeaves")
    holidays            Holiday[]
    notifications       Notification[]

    timesheetEntries             TimesheetEntry[]
    timesheetSubmissions         TimesheetSubmission[] @relation("EmployeeTimesheetSubmissions")
    routedTimesheetSubmissions   TimesheetSubmission[] @relation("RoutedTimesheetSubmissions")
    approvedTimesheetSubmissions TimesheetSubmission[] @relation("ApprovedTimesheetSubmissions")
    projects                     Project[]

    payslips          Payslip[]
    generatedPayslips Payslip[] @relation("PayslipsGenerated")

    customFields EmployeeCustomField[]

    salaryStructureHistory         SalaryStructureHistory[]
    recordedSalaryStructureEntries SalaryStructureHistory[] @relation("SalaryStructureHistoryRecordedBy")

    exitRecords         ExitRecord[]
    recordedExitRecords ExitRecord[] @relation("ExitRecordsRecordedBy")

    offerLetters          OfferLetter[]
    generatedOfferLetters OfferLetter[] @relation("OfferLettersGeneratedBy")

    taxDeclarations         TaxDeclaration[]
    recordedTaxDeclarations TaxDeclaration[] @relation("TaxDeclarationRecordedBy")

    incomeTaxComputationGenerations          IncomeTaxComputationGeneration[]
    generatedIncomeTaxComputationGenerations IncomeTaxComputationGeneration[] @relation("IncomeTaxComputationGenerationsGeneratedBy")

    resignations        Resignation[]
    decidedResignations Resignation[] @relation("ResignationsDecidedBy")
}

// One row per exit event - kept permanently even across reactivate/rehire
// cycles, so the full history (and each exit's relieving letter text) is
// never lost, unlike User.exitDate which only reflects the latest one.
model ExitRecord {
    id Int @id @default(autoincrement())

    userId Int

    exitDate            DateTime
    relievingLetterText String   @db.Text
    pdfUrl              String?

    recordedById Int

    createdAt DateTime @default(now())

    user       User @relation(fields: [userId], references: [id], onDelete: Cascade)
    recordedBy User @relation("ExitRecordsRecordedBy", fields: [recordedById], references: [id])

    @@index([userId])
}

// One row per resignation request, employee-initiated from their own
// Profile page. Manager can only view it (routed by the employee's current
// managerId, not stored on the row) - only admin can Accept/Reject.
// proposedLastWorkingDate is whatever date the employee chose at submission
// - not yet official. lastWorkingDate is the CONFIRMED date, only set once
// admin accepts: proposedLastWorkingDate + noticePeriodDays (30 by default),
// per the actual notice-period policy - the employee's chosen date is a
// resignation/notice date, not their literal final day, so a full notice
// period is added on top of it once accepted.
model Resignation {
    id Int @id @default(autoincrement())

    userId Int

    reason String @db.Text

    status                  ResignationStatus @default(PENDING)
    noticePeriodDays        Int               @default(30)
    proposedLastWorkingDate DateTime
    lastWorkingDate         DateTime?

    decidedById Int?
    decidedAt   DateTime?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user      User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    decidedBy User? @relation("ResignationsDecidedBy", fields: [decidedById], references: [id])

    @@index([userId])
    @@index([status])
}

// One row per generated offer letter - never overwritten, so admin can
// regenerate later (e.g. after a CTC negotiation) without losing the earlier
// version. The PDF itself isn't stored - it's re-rendered from letterText on
// download, same pattern as ExitRecord.relievingLetterText.
model OfferLetter {
    id Int @id @default(autoincrement())

    userId Int

    offerDate  DateTime
    letterText String   @db.Text
    pdfUrl     String?

    generatedById Int

    createdAt DateTime @default(now())

    user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
    generatedBy User @relation("OfferLettersGeneratedBy", fields: [generatedById], references: [id])

    @@index([userId])
}

// One row per CTC + salary-structure change, so payslips generated for a
// past month use whatever CTC and structure percentages actually applied
// then instead of whatever's live today. `effectiveFrom` is stored as the
// 1st of the month it starts applying - "what applied during month X" is
// just the latest row on/before X. Employees with no rows here yet fall back
// to the live User.salaryCtc field plus a fixed default structure (see
// getEffectiveSalaryConfig), so this only needs to be populated when a raise
// or structure change actually happens, or retroactively for corrections.
model SalaryStructureHistory {
    id Int @id @default(autoincrement())

    userId Int

    ctc           Float
    effectiveFrom DateTime

    // Same fields the old company-wide SalaryStructureConfig used to hold,
    // now captured per employee per effective period instead of one global
    // value shared by everyone.
    basicPercentOfCtc                 Float
    hraPercentOfBasic                 Float
    ltaPercentOfBasic                 Float
    guaranteedAllowancePercentOfBasic Float
    conveyanceMonthly                 Float
    pfMonthlyAmount                   Float
    professionalTax                   Float
    professionalTaxThreshold          Float

    createdAt    DateTime @default(now())
    recordedById Int?

    user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    recordedBy User? @relation("SalaryStructureHistoryRecordedBy", fields: [recordedById], references: [id])

    @@index([userId, effectiveFrom])
}

// One row per employee per financial year - only meaningful for employees on
// the Old Tax Regime, who need these declared to compute HRA exemption and
// deductions (80C/80D/home loan interest) for the annual Income Tax
// Computation Statement. New Regime employees don't need this at all (their
// computation only needs Gross Salary + the flat Standard Deduction).
// `financialYear` is stored as the starting year (e.g. 2025 means FY 2025-26).
model TaxDeclaration {
    id Int @id @default(autoincrement())

    userId Int

    financialYear Int

    rentPaidAnnual Float   @default(0)
    isMetroCity    Boolean @default(false)

    section80C       Float @default(0)
    section80D       Float @default(0)
    homeLoanInterest Float @default(0)

    otherIncomeSavingsInterest Float @default(0)
    otherIncomeFDInterest      Float @default(0)

    recordedById Int?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user       User  @relation(fields: [userId], references: [id], onDelete: Cascade)
    recordedBy User? @relation("TaxDeclarationRecordedBy", fields: [recordedById], references: [id])

    @@unique([userId, financialYear])
    @@index([userId])
}

// One row per "Generate" click - a frozen snapshot of the Income Tax
// Computation Statement at that exact moment, so it can be looked back on
// later exactly as it was, even if payslips or the employee's declaration
// change afterward. Multiple generations can exist for the same employee +
// financial year (e.g. one in April, another in August) - none get
// overwritten, same as how Payslip keeps one immutable row per month.
// Identity fields (name/PAN/address/etc.) aren't duplicated here - those are
// read live from the employee's profile at PDF render time, since they
// rarely change and don't need point-in-time freezing the way these figures do.
model IncomeTaxComputationGeneration {
    id Int @id @default(autoincrement())

    userId Int

    financialYear Int

    generatedAt   DateTime @default(now())
    generatedById Int

    regime TaxRegime

    // Whether this generation was a running estimate or the confirmed final
    // figure, at the moment it was generated.
    mode          IncomeTaxComputationMode
    monthsElapsed Int

    grossSalary       Float
    standardDeduction Float
    hraExemption      Float @default(0)
    section80C        Float @default(0)
    section80D        Float @default(0)
    homeLoanInterest  Float @default(0)
    taxableSalary     Float

    otherIncomeSavingsInterest Float @default(0)
    otherIncomeFDInterest      Float @default(0)

    totalIncome        Float
    totalIncomeRounded Float

    slabTax           Float
    rebate87A         Float @default(0)
    cess              Float
    totalTaxLiability Float

    tdsDeductedSoFar Float
    taxPayable       Float @default(0)
    taxRefundable    Float @default(0)

    pdfUrl String?

    user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
    generatedBy User @relation("IncomeTaxComputationGenerationsGeneratedBy", fields: [generatedById], references: [id])

    @@index([userId, financialYear])
}

// Admin-defined ad-hoc fields per employee (label + text value and/or an
// uploaded document) - lets admin capture something new without a code change.
model EmployeeCustomField {
    id Int @id @default(autoincrement())

    userId Int

    label String

    value String?

    documentUrl String?

    createdAt DateTime @default(now())
    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model OTP {
    id Int @id @default(autoincrement())

    userId Int

    otp String

    purpose OTPPurpose

    expiresAt DateTime

    isVerified Boolean @default(false)

    attempts Int @default(0)

    usedAt DateTime?

    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model RefreshToken {
    id Int @id @default(autoincrement())

    userId Int

    token String @unique

    expiresAt DateTime

    isRevoked Boolean @default(false)

    deviceInfo String?

    ipAddress String?

    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
}

model LeavePolicy {
    id Int @id @default(autoincrement())

    leaveName String @unique

    allocatedLeaves Int

    // Set only for leave types that accrue monthly (e.g. 1.0 = one day
    // credited on the 1st of every month) instead of being granted as a
    // lump sum at the start of the fiscal year. Null means the old
    // lump-sum-upfront behavior (e.g. Unpaid Leave, which is unlimited
    // anyway). See leaveBalance.service.js's getOrCreateBalance.
    monthlyAccrualDays Float?

    isUnlimited Boolean @default(false)

    // Marks this as the Loss-of-Pay / unpaid leave type - approved requests
    // under this policy deduct salary in payroll instead of being paid time off.
    isUnpaid Boolean @default(false)

    allowHalfDay Boolean @default(true)

    maxLeavesPerRequest Int

    // How many days ahead of today this leave type can be booked (0 = today
    // only, 1 = today or tomorrow, etc). Null means no policy-specific limit -
    // falls back to the company-wide future-leave settings.
    maxAdvanceBookingDays Int?

    // Minimum-notice rule for long requests: if a request's totalDays exceeds
    // longRequestThresholdDays, its start date must be at least
    // longRequestMinNoticeDays days after today. Both null means no such rule.
    longRequestThresholdDays Int?
    longRequestMinNoticeDays Int?

    // Attachment override: once totalDays exceeds attachmentRequiredAboveDays,
    // a supporting document becomes mandatory to submit at all. Providing one
    // raises the per-request cap to maxLeavesPerRequestWithAttachment and lifts
    // the maxAdvanceBookingDays window for that request. Null means no such rule.
    attachmentRequiredAboveDays       Int?
    maxLeavesPerRequestWithAttachment Int?

    description String?

    isActive Boolean @default(true)

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    leaveBalances LeaveBalance[]

    leaveRequests LeaveRequest[]
}

model LeaveBalance {
    id Int @id @default(autoincrement())

    userId Int

    leavePolicyId Int

    // Float, not Int - accrual policies credit fractional days (e.g. half
    // days, or an overage split that leaves a fractional remainder) and
    // need to track those precisely rather than rounding to whole days.
    allocatedLeaves Float

    usedLeaves Float @default(0)

    remainingLeaves Float

    year Int

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

    @@unique([userId, leavePolicyId, year])
    @@index([userId])
    @@index([leavePolicyId])
}

model LeaveRequest {
    id Int @id @default(autoincrement())

    userId Int

    leavePolicyId Int

    routedToId Int?

    approvedById Int?

    startDate DateTime

    endDate DateTime

    totalDays Float

    // True only for a request created under the sandwich rule (Casual Leave
    // spanning a weekend between two leave-covered working days) - payroll's
    // LOP day count reads this instead of blindly excluding every weekend,
    // since a plain re-walk of the date range can't tell a sandwiched
    // weekend apart from a normal one once this is a standalone row (see
    // payroll.service.js's countLopDaysInMonth).
    weekendsCountAsLeave Boolean @default(false)

    reason String

    status LeaveStatus @default(PENDING)

    managerRemarks String?

    approvedAt DateTime?

    rejectedAt DateTime?

    cancelledAt DateTime?

    attachmentUrl String?

    // True when a manager logged this leave directly on the employee's behalf
    // (auto-approved at creation) rather than the employee submitting it
    // themselves for approval.
    createdByManager Boolean @default(false)

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    user User @relation("EmployeeLeaveRequests", fields: [userId], references: [id], onDelete: Cascade)

    routedTo User? @relation("RoutedLeaveRequests", fields: [routedToId], references: [id])

    approvedBy User? @relation("ManagerApprovedLeaves", fields: [approvedById], references: [id])

    leavePolicy LeavePolicy @relation(fields: [leavePolicyId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([leavePolicyId])
    @@index([routedToId])
    @@index([approvedById])
    @@index([status])
}

model CompanySettings {
    id Int @id @default(autoincrement())

    companyName String

    // Which calendar month the leave/fiscal year starts in (1 = January, 4 =
    // April, etc). Leave-balance year buckets and payroll YTD both reset on
    // the 1st of this month, instead of a fixed manually-tracked year number.
    fiscalYearStartMonth Int @default(4)

    timezone String @default("Asia/Kolkata")

    allowPastLeave Boolean @default(false)

    allowFutureLeave Boolean @default(true)

    maxFutureDays Int @default(90)

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt
}

// Company-wide payroll formula, admin-configurable - a single row (like
// CompanySettings). Every employee's monthly earnings breakdown is derived
// from their salaryCtc using these percentages at payslip generation time.

// One immutable snapshot per employee per month. Once generated it's a
// historical record - admin can regenerate (overwrite) it if a correction is
// needed, but nothing recalculates it automatically after the fact.
model Payslip {
    id Int @id @default(autoincrement())

    userId Int

    month Int
    year  Int

    basic               Float
    hra                 Float
    lta                 Float
    conveyance          Float
    guaranteedAllowance Float
    specialAllowance    Float
    annualBonusPay      Float @default(0)

    pfEmployee      Float
    pfEmployer      Float
    professionalTax Float
    tds             Float @default(0)

    lopDays   Float @default(0)
    lopAmount Float @default(0)

    standardDays Float @default(0)
    daysWorked   Float @default(0)

    grossPay        Float
    grossDeductions Float
    netPay          Float

    pdfUrl String?

    generatedById Int

    generatedAt DateTime @default(now())
    updatedAt   DateTime @updatedAt

    user        User @relation(fields: [userId], references: [id], onDelete: Cascade)
    generatedBy User @relation("PayslipsGenerated", fields: [generatedById], references: [id])

    @@unique([userId, month, year])
    @@index([userId])
}

model WeekendPolicy {
    id Int @id @default(autoincrement())

    dayOfWeek DayOfWeek

    weekNumber WeekNumber @default(ALL)

    isHoliday Boolean @default(true)

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    @@unique([dayOfWeek, weekNumber])
}

model Holiday {
    id Int @id @default(autoincrement())

    holidayName String

    holidayDate DateTime

    description String?

    isOptional Boolean @default(false)

    isActive Boolean @default(true)

    createdById Int

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    createdBy User @relation(fields: [createdById], references: [id])

    @@unique([holidayDate])
    @@index([holidayDate])
    @@index([createdById])
}

model Notification {
    id Int @id @default(autoincrement())

    userId Int

    title String

    message String

    type String

    isRead Boolean @default(false)

    readAt DateTime?

    createdAt DateTime @default(now())

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    @@index([userId])
    @@index([isRead])
}

// One task-level record. Multiple entries can share the same date (different
// tasks worked the same day). Freely add/edit/delete while unsubmitted
// (timesheetSubmissionId is null); once the week is submitted, entries are
// locked to that submission and become read-only history.
model TimesheetEntry {
    id Int @id @default(autoincrement())

    userId Int

    date DateTime

    hoursWorked Float

    description String?

    // Monday of the week `date` falls in - stamped at creation, used to group
    // entries together when the employee submits the week.
    weekStartDate DateTime

    timesheetSubmissionId Int?

    // Which project this entry's hours are logged against - each project an
    // employee is assigned to has its own independent day-by-day grid, so
    // the same calendar date can hold one entry per project. Nullable only
    // for entries that predate per-project timesheets (every entry created
    // from here on always has one).
    projectId Int?

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    user User @relation(fields: [userId], references: [id], onDelete: Cascade)

    timesheetSubmission TimesheetSubmission? @relation(fields: [timesheetSubmissionId], references: [id], onDelete: SetNull)

    project Project? @relation(fields: [projectId], references: [id])

    // At most one entry per user per calendar day per project - the weekly
    // grid UI edits a day's entry in place rather than allowing several per
    // day within the SAME project's grid.
    @@unique([userId, date, projectId])
    @@index([userId])
    @@index([weekStartDate])
    @@index([timesheetSubmissionId])
    @@index([projectId])
}

// The weekly bundle an employee submits for their manager's approval - same
// shape as LeaveRequest (routedTo/approvedBy/status/remarks) so it reuses a
// pattern already trusted elsewhere in this app.
model TimesheetSubmission {
    id Int @id @default(autoincrement())

    userId Int

    weekStartDate DateTime

    weekEndDate DateTime

    totalHours Float

    routedToId Int?

    approvedById Int?

    status LeaveStatus @default(PENDING)

    managerRemarks String?

    // The Excel sheet the employee attaches when submitting this week -
    // mandatory alongside the day-by-day entries. Stored name is the random
    // on-disk filename; original name is kept so managers/admins download it
    // under a recognizable name instead of a UUID.
    attachmentOriginalName String?

    attachmentStoredName String?

    // Whether the employee has a project assigned this week - mandatory to
    // submit, but "sticky": the frontend pre-fills each new week with the
    // employee's last choice so they only need to change it when it changes.
    projectAssigned ProjectAssignmentStatus?

    // Which project this week's submission is for - an employee assigned to
    // several projects submits one of these per project per week, not one
    // combined submission (see the unique constraint below). Nullable only
    // for submissions that predate per-project timesheets.
    projectId Int?

    submittedAt DateTime @default(now())

    approvedAt DateTime?

    rejectedAt DateTime?

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    user User @relation("EmployeeTimesheetSubmissions", fields: [userId], references: [id], onDelete: Cascade)

    routedTo User? @relation("RoutedTimesheetSubmissions", fields: [routedToId], references: [id])

    approvedBy User? @relation("ApprovedTimesheetSubmissions", fields: [approvedById], references: [id])

    project Project? @relation(fields: [projectId], references: [id])

    entries TimesheetEntry[]

    // One submission per employee per week per project - not just per week -
    // so an employee on 2 projects can have 2 independent submissions for
    // the same week, each with its own approval.
    @@unique([userId, weekStartDate, projectId])
    @@index([userId])
    @@index([routedToId])
    @@index([status])
    @@index([projectId])
}

// Admin-managed master list of projects employees pick from when filling
// their timesheet - keeps names consistent instead of employees free-typing
// slightly different spellings of the same project. "Deleting" a project
// deactivates it (isActive = false) rather than removing the row, so past
// timesheets that already referenced it keep showing its name correctly.
model Project {
    id Int @id @default(autoincrement())

    name String @unique

    isActive Boolean @default(true)

    // Client vs internal, and the working-hours window employees on this
    // project should expect - set once by admin, then just displayed to the
    // employee once they pick the project on their timesheet (see
    // ProjectAssignmentStatus reuse: TimesheetSubmission.projectAssigned is
    // copied straight from here at submit time, not chosen by the employee).
    // Free text rather than an enum - admin can pick one of the common
    // suggestions on the frontend or type any other timezone label directly.
    projectType   ProjectAssignmentStatus @default(NOT_ASSIGNED)
    timezone      String                  @default("IST")
    workStartTime String                  @default("09:00")
    workEndTime   String                  @default("18:00")

    // Set by admin on create, editable later - shown automatically on the
    // employee's own timesheet alongside project type/working hours.
    // endDate is nullable - a project may still be ongoing with no planned
    // end date yet.
    startDate DateTime
    endDate   DateTime?

    // Whether employees on this project fill in and submit one timesheet per
    // week or per calendar month - drives both the grid on their own
    // timesheet page and how TimesheetEntry/TimesheetSubmission group days
    // together (see timesheetService.getPeriodStart/getPeriodEnd). Defaults
    // to WEEKLY so every project created before this field existed keeps
    // behaving exactly as it always has.
    submissionFrequency SubmissionFrequency @default(WEEKLY)

    createdById Int

    createdAt DateTime @default(now())

    updatedAt DateTime @updatedAt

    createdBy User @relation(fields: [createdById], references: [id])

    timesheetSubmissions TimesheetSubmission[]
    timesheetEntries     TimesheetEntry[]
    memberships          ProjectMembership[]
}

// One row per (employee, project) they're currently assigned to - an
// employee can be on several projects at once, each with its own
// independent timesheet (see TimesheetEntry/TimesheetSubmission.projectId).
// assignedAt is what the admin Project report's "Since" column reads per
// employee-project pairing, now that there can be more than one per employee.
model ProjectMembership {
    id Int @id @default(autoincrement())

    userId    Int
    projectId Int

    assignedAt DateTime @default(now())

    user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
    project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

    @@unique([userId, projectId])
    @@index([userId])
    @@index([projectId])
}
